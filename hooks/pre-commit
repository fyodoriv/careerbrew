#!/usr/bin/env bash
# Repo-local pre-commit hook. A global core.hooksPath (dotfiles) delegates here; without one,
# lefthook installs the same commands from lefthook.yml.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if command -v lefthook >/dev/null 2>&1; then exec lefthook run --no-auto-install pre-commit; fi
command -v gitleaks >/dev/null 2>&1 || { echo "gitleaks missing (fix: brew install gitleaks)" >&2; exit 1; }
gitleaks git --staged --no-banner --redact -l warn
scripts/leak-check.sh --staged
scripts/check-docs.sh
