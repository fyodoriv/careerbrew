# Allowlist: ignore everything, then list what may be committed (docs/privacy.md).
# A new top-level path must be added here on purpose; private data can never slip in.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.env.example
!/.python-version
!/AGENTS.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/INSTALL.md
!/LICENSE
!/Agentfile.yaml
!/README.md
!/commands/
!/RECURRING.md
!/TASKS.md
!/lefthook.yml
!/pyproject.toml
!/uv.lock
!/config/
!/docs/
!/evals/
!/hooks/
!/knowledge/
!/memory/
!/profile/
!/prompts/
!/scripts/
!/skills/
!/src/
!/tests/
!/web/

# Never, even inside allowed folders
.claude/
node_modules/
web/dist/
web/test-results/
web/playwright-report/
*.tsbuildinfo
private/
.env
.env.*
!.env.example
__pycache__/
*.pyc
.metrics/
*.cbk
*.cbsync
.DS_Store

# Allow the Rust migration workspace and its explicit source files.
!/Cargo.toml
!/Cargo.lock
!/experiments/
/experiments/*
!/experiments/hash/
/experiments/hash/*
!/experiments/hash/Cargo.toml
!/experiments/hash/src/
