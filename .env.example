# Names only; real values go in .env (never committed). scripts/doctor.sh
# checks every line marked "# required".
# ERROR_REPORTER=sentry   # optional: send errors to an external service; off by default
# SENTRY_DSN=             # optional: only with ERROR_REPORTER=sentry

# Optional: full LeetCode sync of every solved problem (your browser's leetcode.com cookies). Sent only to leetcode.com.
# Unofficial endpoint: it may be against the site's terms. Off by default (leave empty); manual marking is the safe way.
LEETCODE_SESSION=
LEETCODE_CSRF=
